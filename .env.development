# Base
ENVIRONMENT='development'
PROJECT_NAME='kiki-core-stack'

# Auth

## Origin of each frontend, checked at the handshake; the same as the *_AUTH_ORIGIN of the backends.
ADMIN_AUTH_ORIGIN=''

# Internal APIs
MANAGEMENT_BACKEND_API_BASE_URL=''
MANAGEMENT_BACKEND_API_INTROSPECTION_TOKEN=''

# Logger
LOGGER_LOG_DIR='./logs'
LOGGER_LOG_TO_FILE=true
RUST_LOG='info'

# Public
MONGODB_RS_HOST='127.0.0.1'
MONGODB_URI="mongodb://${MONGODB_RS_HOST}:27017/${PROJECT_NAME}-${ENVIRONMENT}?directConnection=true&replicaSet=rs0"
REDIS_URL='redis://127.0.0.1:6379?protocol=resp3'

# Server
SERVER_HOST='127.0.0.1'
SERVER_PORT=8080

# Service auth keys
MANAGEMENT_BACKEND_AUTH_KEY=''

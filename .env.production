# Base
ENVIRONMENT='production'
PROJECT_NAME='kiki-core-stack'

# Logger
LOGGER_LOG_DIR='./logs'
LOGGER_LOG_TO_FILE=true
RUST_LOG='info'

# Server

## Proxies trusted to forward X-Forwarded-For (comma-separated IPs, CIDRs, or loopback/linklocal/uniquelocal), the same
## setting as the backends' SERVER_TRUSTED_PROXIES. Default: loopback,linklocal,uniquelocal. The proxy connecting to this
## service (the gateway) is always trusted, so setting it empty makes the rightmost entry the client IP.
# SERVER_TRUSTED_PROXIES='loopback,linklocal,uniquelocal'
